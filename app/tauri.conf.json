{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VILauncher",
  "version": "0.1.0",
  "identifier": "io.github.lportvi.vilauncher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VILauncher",
        "width": 1040,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Game",
    "shortDescription": "Runs VIctory or XCL on Linux through Proton or Wine",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/SixLauncher/launcher/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBMzE5RUMzOUI1NzlDQUIKUldTcm5GZWJ3NTR4YXBwNUw4TW96VVJZUjdpY1YvbzBaSVpid2pCVWJGZkNYSGhIdmJnelZyc2EK",
      "requireSignedVersion": true
    }
  }
}
